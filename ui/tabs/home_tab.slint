import { MacroBar } from "../components/macro_bar.slint";
import { ArcProgressBar, ArcData } from "../components/arc_progress_bar.slint";
import { MacroValues } from "../types.slint";
import { LogItem, LogDisplayData } from "../components/log_item.slint";

export component HomeTab inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;

    in property <MacroValues> totals;
    in property <MacroValues> goals;
    in property <bool> has-goals;
    in property <[LogDisplayData]> food-log;
    in property <string> dashboard-error;
    callback open-scanner();


    // Base container
    VerticalLayout {
        width: 100%;
        height: 100%;

        // Arc progress bar
        VerticalLayout {
            padding: 10px;
            padding-top: 45px;
            alignment: start;
        
            Rectangle {
                height: 180px;
                background: #181825;
                border-radius: 20px;

                ArcProgressBar {
                    center-text-primary: round(root.totals.kcal) + "";
                    center-text-secondary: root.goals.kcal > 0 ? "out of " + round(root.goals.kcal) + "kcal" : root.has-goals ? "kcal" : "kcal • No daily goals set";

                    arcs: [
                        { color: #cf2626, current: root.totals.proteins, max: root.goals.proteins, unit: "g" },
                        { color: #29bdeb, current: root.totals.carbohydrates, max: root.goals.carbohydrates, unit: "g" },
                        { color: #25aa37, current: root.totals.fat, max: root.goals.fat, unit: "g" }
                    ];
                }
            }
        }

        // Macro bars
        VerticalLayout {
            spacing: 15px;
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 10px;
            padding-bottom: 20px;
            
            Text {
                text: "Macros";
                color: #cdd6f4;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            MacroBar { title: "Proteins"; bar-color: #cf2626; current: root.totals.proteins; max: root.goals.proteins; }
            MacroBar { title: "Carbohydrates"; bar-color: #29bdeb; current: root.totals.carbohydrates; max: root.goals.carbohydrates; }
            MacroBar { title: "Fats"; bar-color: #25aa37; current: root.totals.fat; max: root.goals.fat; }
            MacroBar { title: "Kcal"; bar-color: #dbb015; current: root.totals.kcal; max: root.goals.kcal; unit: "kcal"; }
        }

        // Daily logs
        Flickable {
            // vertical-stretch to force occupying free space
            vertical-stretch: 1;
            viewport-height: main-layout.preferred-height;

            main-layout := VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 20px;
                alignment: start;

                Text {
                    text: "Daily Log";
                    color: #cdd6f4;
                    font-size: 20px;
                    font-weight: 700;
                }

                VerticalLayout {
                    spacing: 10px;
                    
                    // A failed load must not be presented as an empty day.
                    // Existing rows remain visible if a later refresh fails.
                    if root.dashboard-error != "" : Text {
                        text: root.dashboard-error;
                        color: #f38ba8;
                        wrap: word-wrap;
                    }
                    if root.food-log.length == 0 && root.dashboard-error == "" : Text {
                        text: "No food logged today. Tap + to add food.";
                        color: #a6adc8;
                        wrap: word-wrap;
                    }
                    for item in root.food-log : LogItem {
                        name: item.name;
                        details: item.details;
                        calories: item.calories;
                        proteins: item.proteins;
                        carbohydrates: item.carbohydrates;
                        fats: item.fats;
                    }
                }
                
                // Spacer to be able to scroll the last item above FAB 
                Rectangle { height: 100px; }
            }
        }
    }

    // 4. Floating Action Button (FAB)
    Rectangle {
        width: 50px;
        height: 50px;

        x: parent.width - self.width - 20px;
        y: parent.height - self.height - 20px;

        background: #26d61a;
        border-radius: self.width / 2;

        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 4px;

        Image {
            source: @image-url("../icons/plus.svg");
            width: 32px;
            height: 32px;
            colorize: #11111b;

            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        TouchArea {
            width: 100%;
            height: 100%;

            clicked => {
                root.open-scanner();
            }
        }
    }

}
