import { Button } from "std-widgets.slint";
import { LineEdit } from "line_edit.slint";

// Android supplies a native camera screen. This overlay handles lookup and
// explicit quantity confirmation, and provides manual entry on every platform.
export component ScannerOverlay inherits Rectangle {
    in-out property <string> barcode;
    in-out property <string> quantity;
    in property <string> product;
    in property <string> status-text;
    in property <bool> busy;
    in property <bool> ready;
    in property <bool> camera-available;
    callback close();
    callback start-camera();
    callback lookup();
    callback barcode-edited();
    callback confirm();
    background: #181825;
    TouchArea {} // Block touches to the dashboard and footer underneath.
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;
        Text { text: "Add food"; color: #cdd6f4; font-size: 26px; font-weight: 700; }
        if root.camera-available : Button {
            text: "Scan barcode";
            enabled: !root.busy;
            clicked => { root.start-camera(); }
        }
        Text { text: "Barcode"; color: #a6adc8; }
        LineEdit {
            text <=> root.barcode;
            placeholder-text: "Enter product barcode";
            input-type: number;
            enabled: !root.busy;
            edited => { root.barcode-edited(); }
        }
        Button { text: "Find product"; enabled: !root.busy; clicked => { root.lookup(); } }
        Text { text: root.status-text; color: #a6adc8; wrap: word-wrap; }
        if root.ready : VerticalLayout {
            spacing: 16px;
            Text { text: root.product; color: #cdd6f4; wrap: word-wrap; font-size: 20px; }
            Text { text: "Consumed quantity (g)"; color: #a6adc8; }
            LineEdit { text <=> root.quantity; placeholder-text: "e.g. 100"; input-type: decimal; }
            Button { text: "Add to today's log"; enabled: !root.busy; clicked => { root.confirm(); } }
        }
        Button { text: "Cancel"; clicked => { root.close(); } }
    }
}
